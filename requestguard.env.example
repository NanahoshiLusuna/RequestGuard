# Termux: pkg install python
# cp requestguard.env.example requestguard.env
# sh run.sh
#
# 계정 페이지에서 발급한 키만 넣습니다. 가입 확인 링크는 키가 아닙니다.
# 키가 잘못됐거나 AbuseIPDB가 실패하면 저장된 차단, 속도, 형식만으로 판단합니다.
# https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=

# 0.0.0.0 이면 루프백을 제외한 이 기기의 주소마다 엽니다.
# all 이면 1-65535를 검사하고, 접속한 포트 번호 그대로 아래 앱 주소로 넘깁니다.
# 앱은 127.0.0.1에만 바인드하세요. 0.0.0.0에 열린 포트는 검사가 붙지 않습니다.
LISTEN_HOST=0.0.0.0
LISTEN_PORTS=all
LISTEN_PORT=8080

# 실제 앱. 포트는 클라이언트가 접속한 포트를 그대로 씁니다.
UPSTREAM_HOST=127.0.0.1
UPSTREAM_PORT=3000

# AbuseIPDB abuseConfidenceScore. 0은 신고 없음, 25는 신고가 잡힌 최소 점수, 75는 고신뢰.
# 이 값은 미국처럼 애매한 국가의 기준입니다.
ABUSE_SCORE_THRESHOLD=75

# 한국, 일본은 신뢰. 점수가 높아도 이 값 미만이면 통과하고, 초당 허용도 느슨합니다.
TRUST_COUNTRIES=KR,JP
TRUST_SCORE_THRESHOLD=90
TRUST_RATE_LIMIT_PER_SEC=60

# 미국은 애매. 비어 있지 않은 한 위 기본 점수와 RATE_LIMIT_PER_SEC를 씁니다.
MIXED_COUNTRIES=US

# 중국과 그 외 국가. 신고가 잡히면 막고, 초당 허용도 좁습니다.
LOW_SCORE_THRESHOLD=25
LOW_RATE_LIMIT_PER_SEC=10

# 블랙리스트, 형식 이상, 평소 과다 요청의 기본 보관 일수
BAN_DAYS=30

# 더 빠른 요청은 일수를 늘립니다. 30/s=30일, 60/s=60일, 120/s=120일.
# 계산은 BAN_DAYS * (초당 횟수 / RATE_LIMIT_PER_SEC) 이고, 이 값을 넘기지 않습니다.
MAX_BAN_DAYS=365

# 이 횟수 이상이면 그 초의 연결부터 차단합니다. 연결 하나가 요청 하나입니다.
# 같은 망의 MAC이 보이면 IP와 MAC을 같이 셉니다. 하나라도 넘으면 그 연결의 IP와 MAC을 막습니다.
RATE_LIMIT_PER_SEC=30

# 쉼표로 구분. IP 또는 MAC이 여기 있으면 검사와 차단에서 제외합니다.
WHITELIST=
